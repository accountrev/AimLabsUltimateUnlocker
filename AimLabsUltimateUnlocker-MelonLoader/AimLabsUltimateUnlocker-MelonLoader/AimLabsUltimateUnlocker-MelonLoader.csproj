<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>AimLabsUltimateUnlocker_MelonLoader</RootNamespace>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>AimLabsUltimateUnlocker_MelonLoader</AssemblyName>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<Reference>
			<Private>false</Private>
		</Reference>
	</ItemDefinitionGroup>

	<!-- THIS IS REQUIRED TO FIND AIM LABS FOR BUILDING -->
	<Import Project="AimLabsDirectory.props" Condition="Exists('AimLabsDirectory.props')" />

	<!-- IF THE FILE DOESNT EXIST, IT WILL USE DEFAULT STEAM DIRECTORY -->
	<PropertyGroup>
		<AimLabsDirectory Condition="'$(AimLabsDirectory)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Aim Lab</AimLabsDirectory>

		<Il2CppAssembliesDir>$(AimLabsDirectory)/MelonLoader/Il2CppAssemblies</Il2CppAssembliesDir>

		<NoWarn>$(NoWarn);NU1603;NU1701</NoWarn>

		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(Il2CppAssembliesDir)/*.dll" />
	</ItemGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Core.cs" />
		<Compile Include="UnlockPatch.cs" />
	</ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('$(AimLabsDirectory)/Mods')">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AimLabsDirectory)/Mods" />
	</Target>
</Project>
